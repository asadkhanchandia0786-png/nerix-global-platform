modules = ["nodejs-22"]
entrypoint = "server/index.ts"
run = ["env", "TRUST_PROXY=1", "npm", "run", "dev"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 24678
externalPort = 3000

[deployment]
build = ["sh", "-c", "npm ci --include=dev && npm run build"]
run = ["env", "NODE_ENV=production", "TRUST_PROXY=1", "npm", "start"]
