# ---------- Dashboard / API (portal) ----------
# Local preview needs none of this. For the live server these go in /etc/nerix-portal/portal.env (see docs/DEPLOY-ORACLE.md).
PORT=3000
# demo = test workspaces with fake credit. pilot = real customers (the default when NODE_ENV=production).
APP_MODE=demo
# REQUIRED in production: the exact HTTPS address customers use, no trailing slash, e.g. https://app.nerixglobal.com
# APP_ORIGIN=https://app.nerixglobal.com
# REQUIRED in production: your Neon connection string (create a separate database for Nerix).
# DATABASE_URL=postgresql://user:password@host/nerix?sslmode=require
# REQUIRED in production: long random value, entered once to create the owner account.
# SETUP_TOKEN=
# 1 only when exactly one trusted proxy sits in front (Cloudflare Tunnel on the same server counts as one).
TRUST_PROXY=1

# ---------- Inbound calls ----------
# Turn on only after setting a secret of 32+ random characters; the SAME value goes in the gateway's NERIX_GATEWAY_SECRET.
ENABLE_GATEWAY_API=false
# NERIX_GATEWAY_SECRET=
# Most simultaneous staff-transfer legs across all customers (also set in the gateway env).
GATEWAY_MAX_OUTBOUND_CALLS=5

# ---------- Email (Resend) ----------
# RESEND_API_KEY=
# EMAIL_FROM="Nerix Global <hello@nerixglobal.com>"

# ---------- Website text chat (never put this key in website files) ----------
# OPENAI_API_KEY=
CHAT_AI_ENABLED=false
CHAT_MODEL=gpt-4.1-mini
CHAT_AI_DAILY_LIMIT=200
# Card payments stay manual in this release. Do not set LIVE_PAYMENTS_ENABLED.
