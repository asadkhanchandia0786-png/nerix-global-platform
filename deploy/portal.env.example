# /etc/nerix-portal/portal.env on the Oracle VM  (root:nerix-portal, mode 0640). Never commit real values.
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://app.nerixglobal.com
# Neon: a separate database for Nerix (not Dentive's). Use the pooled or direct string from the Neon console; it must end with ?sslmode=require
DATABASE_URL=
# Long random value; used once at https://app.nerixglobal.com to create the owner account. Generate: openssl rand -hex 32
SETUP_TOKEN=
# Cloudflare Tunnel runs on this same VM, which counts as exactly one trusted proxy.
TRUST_PROXY=1
ENABLE_GATEWAY_API=true
# Same value as NERIX_GATEWAY_SECRET in /etc/nerix/gateway.env
NERIX_GATEWAY_SECRET=
GATEWAY_MAX_OUTBOUND_CALLS=5
RESEND_API_KEY=
EMAIL_FROM="Nerix Global <hello@nerixglobal.com>"
OPENAI_API_KEY=
CHAT_AI_ENABLED=true
CHAT_MODEL=gpt-4.1-mini
CHAT_AI_DAILY_LIMIT=200
