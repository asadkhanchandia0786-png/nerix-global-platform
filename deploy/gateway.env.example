# /etc/nerix/gateway.env on the Oracle VM  (root:nerix-gateway, mode 0640). Never commit real values.
# Values marked COPY come unchanged from your working /etc/dentive/gateway.env.
ENABLE_SIP_GATEWAY=false
# The dashboard runs on this same VM, so the gateway talks to it over loopback (no internet hop, no public exposure needed).
NERIX_APP_URL=http://127.0.0.1:3000
# 32+ random characters; the SAME value as NERIX_GATEWAY_SECRET in /etc/nerix-portal/portal.env. Generate: openssl rand -hex 32
NERIX_GATEWAY_SECRET=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
ARI_URL=http://127.0.0.1:8088/ari
ARI_USERNAME=nerix_gateway
ARI_PASSWORD=
SIP_ENDPOINT=nerix-carrier
# COPY the next block (provider addresses and NAT settings) from your Dentive file:
SIP_SERVER=
SIP_USERNAME=
SIP_PASSWORD=
SIP_INBOUND_DID=
SIP_TRUSTED_IPS=
SIP_TRANSPORT=udp
SIP_SERVER_PORT=5060
SIP_MEDIA_ENCRYPTION=no
PUBLIC_IPV4=
SIP_LOCAL_NETWORKS=
SIP_TLS_CERT_FILE=
SIP_TLS_KEY_FILE=
SIP_TLS_CA_FILE=
GATEWAY_STATE_DIR=/var/lib/nerix-gateway
GATEWAY_MAX_CALLS=5
# Must equal GATEWAY_MAX_OUTBOUND_CALLS on the dashboard side.
GATEWAY_MAX_OUTBOUND_CALLS=5
GATEWAY_RING_SECONDS=25
GATEWAY_ACCEPT_SECONDS=20
GATEWAY_MAX_CALL_SECONDS=3300
GATEWAY_ROUTING_FILE=/etc/nerix/gateway-routing.json
# COPY: VoIPstudio values referenced by the routing file.
VS_SERVER=
VS_USERNAME=
VS_PASSWORD=
VS_TRUSTED_IPS=
VS_FORWARDING_IPS=
